# Smart Clock Alpine: busybox init (no OpenRC). Boot work lives in /etc/clock/rcS.
::sysinit:/etc/clock/rcS
# Root shell on the USB CDC-ACM serial port (/dev/cu.usbmodem* on the Mac).
ttyGS0::respawn:/sbin/getty -n -l /usr/local/bin/autologin 0 ttyGS0 vt100
::respawn:/usr/sbin/dropbear -F -R -s -p 22
# The clock face on the screen (/dev/fb0).
::respawn:/usr/local/bin/clockface
# Home Assistant data for the clock face (needs /etc/clock/ha.conf).
::respawn:/usr/local/bin/ha-poll
# Now playing on the clock face (needs HA_PLAYER in ha.conf).
::respawn:/usr/local/bin/ha-media
# Alarms (set in Home Assistant helpers; see homeassistant/smart_clock.yaml).
::respawn:/usr/local/bin/clock-alarm
# Backlight from the ambient light sensor.
::respawn:/usr/local/bin/autobright
# Buttons and mic switch (actions in /etc/clock/keys.conf).
::respawn:/usr/local/bin/clockkeys
# Music Assistant player (squeezelite): finds the server itself; plays through the shared
# speaker (dmix, /etc/asound.conf), resampled to 48 kHz; lets go of it after 5 s idle. Its
# volume goes to the amp through clock-volume (VOLUME_HOOK, our patch).
::respawn:/usr/bin/env VOLUME_HOOK="/usr/local/bin/clock-volume player" /usr/local/bin/squeezelite -n "Smart Clock" -o default -r 48000 -R -C 5
# Bluetooth speaker: MediaTek's /dev/stpbt relayed to BlueZ (btrelay), bluez-alsa as an A2DP
# sink playing into the shared speaker, and an agent that accepts pairing without a PIN.
# The later ones wait a little for the ones they need, so they don't respawn in a tight loop.
::respawn:/usr/bin/dbus-daemon --system --nofork --nopidfile
::respawn:/bin/sh -c "sleep 2; exec /usr/lib/bluetooth/bluetoothd -n"
::respawn:/bin/sh -c "while [ ! -e /dev/stpbt ]; do sleep 2; done; sleep 1; exec /usr/local/sbin/btrelay"
::respawn:/bin/sh -c "sleep 5; exec /usr/bin/bluealsa -p a2dp-sink -c -aac -S"
::respawn:/bin/sh -c "until pidof bluealsa >/dev/null; do sleep 1; done; exec /usr/bin/bluealsa-aplay -D default --single-audio --pcm-buffer-time=1000000"
::respawn:/bin/sh -c "sleep 6; exec /usr/bin/bt-agent -c NoInputNoOutput"
::respawn:/bin/sh -c "sleep 8; exec /usr/local/bin/clock-bt-trust"
::respawn:/sbin/watchdog -F -t 5 -T 30 /dev/watchdog
::shutdown:/etc/clock/rc.shutdown
::ctrlaltdel:/sbin/reboot
