# Smart Clock Alpine: busybox init (no OpenRC). Boot work lives in /etc/clock/rcS.
::sysinit:/etc/clock/rcS
# Root shell on the USB CDC-ACM serial port (/dev/cu.usbmodem* on the Mac).
ttyGS0::respawn:/sbin/getty -n -l /usr/local/bin/autologin 0 ttyGS0 vt100
::respawn:/usr/sbin/dropbear -F -R -s -p 22
# The clock face on the screen (/dev/fb0).
::respawn:/usr/local/bin/clockface
# Home Assistant data for the clock face (needs /etc/clock/ha.conf).
::respawn:/usr/local/bin/ha-poll
# Backlight from the ambient light sensor.
::respawn:/usr/local/bin/autobright
# Buttons and mic switch (actions in /etc/clock/keys.conf).
::respawn:/usr/local/bin/clockkeys
# Music Assistant player (squeezelite): finds the server itself; plays through the shared
# speaker (dmix, /etc/asound.conf), resampled to 48 kHz; lets go of it after 5 s idle.
::respawn:/usr/local/bin/squeezelite -n "Smart Clock" -o default -r 48000 -R -C 5
::respawn:/sbin/watchdog -F -t 5 -T 30 /dev/watchdog
::shutdown:/etc/clock/rc.shutdown
::ctrlaltdel:/sbin/reboot
