# Config changes on top of the stock Lenovo Smart Clock kernel config.
# Start from the config embedded in the stock kernel (extract-ikconfig on boot_a's kernel),
# then apply these with scripts/config and `make olddefconfig`. See docs/03-kernel.md.

# USB gadget: serial console (CDC-ACM) + network (CDC-ECM/NCM) over the USB-A port,
# and a sysfs switch to force the MUSB controller into device mode.
CONFIG_MTK_MUSB_SW_WITCH_MODE=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y

# ALSA's dmix (several programs sharing the speaker) needs System V semaphores and shared
# memory, which Android kernels leave out.
CONFIG_SYSVIPC=y

# A minimal Linux userspace needs devtmpfs.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# The bootloader's ramdisk can't be used (docs/04-booting-a-custom-kernel.md), so the
# initramfs is built into the kernel. Point this at your own build/initramfs.list.
CONFIG_INITRAMFS_SOURCE="build/initramfs.list"

# 1 MB log buffer: the default 128 KB is overrun by battery/Wi-Fi driver chatter before
# the display driver's boot messages can be read.
CONFIG_LOG_BUF_SHIFT=20
